# MongoDB Connection
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?appName=Cluster0

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Twilio Configuration
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MSG_SID=your_twilio_messaging_service_id
TWILIO_PHONE_NUMBER=+1234567890

# Image API
IMGBB_API_KEY=your_imgbb_api_key

# ============================================================
# CENTRALIZED HOST CONFIGURATION
# ============================================================
# Change ONLY these values when your machine IP changes.
# All components will pick up the new address.
# ============================================================

# Backend bind address (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Backend port
PORT=5000

# Your machine's LAN IP address
BACKEND_HOST=192.168.1.100

# Full API base URL (used by mobile + admin)
API_BASE_URL=http://192.168.1.100:5000

# Fabric blockchain host
FABRIC_HOST=192.168.1.100
FABRIC_AS_LOCALHOST=false

# Node Environment
NODE_ENV=development
