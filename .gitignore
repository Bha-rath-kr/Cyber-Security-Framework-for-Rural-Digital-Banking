# ============================================================
# HYPERLEDGER FABRIC
# PRIVATE KEYS / CREDENTIALS
# ============================================================

# Fabric private key
**/priv_sk

# Fabric private key variants
**/*_sk

# ALL private .key files
**/*.key

# Private key extensions
**/*.priv
**/*.pem.key

# Fabric MSP private keystores
**/msp/keystore/
**/msp/*/keystore/

# Generic keystore directories
**/keystore/

# Fabric wallet
**/fabric/wallet/
**/wallet/

# Fabric identity files
**/fabric/wallet/*.id
**/wallet/*.id

# Fabric CA private material
**/fabric-ca-server/
**/fabric-ca-client/

# ============================================================
# FABRIC GENERATED CRYPTO MATERIAL
# ============================================================

# Private CA keys
**/crypto-config/**/ca/priv_sk

# Private TLS CA keys
**/crypto-config/**/tlsca/priv_sk

# Private MSP keys
**/crypto-config/**/msp/keystore/

# Private TLS keys
**/crypto-config/**/tls/*.key

# Explicit Fabric private key locations
**/crypto-config/ordererOrganizations/**/ca/priv_sk
**/crypto-config/ordererOrganizations/**/tlsca/priv_sk
**/crypto-config/ordererOrganizations/**/msp/keystore/

**/crypto-config/peerOrganizations/**/ca/priv_sk
**/crypto-config/peerOrganizations/**/tlsca/priv_sk
**/crypto-config/peerOrganizations/**/msp/keystore/


# ============================================================
# FABRIC GENERATED NETWORK / LEDGER DATA
# ============================================================

**/fabric-data/
**/ledger-data/

**/channel-artifacts/
**/system-genesis-block/
**/genesisblock/

**/network/data/
**/network/logs/

**/production/

# CouchDB
**/couchdb/data/
**/couchdb/*/data/

# LevelDB
**/leveldb/
**/data/leveldb/


# ============================================================
# FABRIC CERTIFICATES
# ============================================================

# IMPORTANT:
# Do NOT ignore all .pem or .crt files.
#
# Public Fabric certificates such as:
#   ca-cert.pem
#   server.crt
#   client.crt
#   tlsca-cert.pem
#
# may be required by the project.
#
# Private .key and priv_sk files are already ignored above.


